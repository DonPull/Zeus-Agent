{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeus Agent",
  "version": "0.1.0",
  "identifier": "com.zeus.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zeus Agent",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}